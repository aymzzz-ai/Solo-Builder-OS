# Secrets (SAF-1) — never committed, never exported. No negation for .env.example:
# git does not descend into an excluded directory, so a re-include under .secrets/ can
# never fire. The example file is generated by scripts/project-contract.js instead.
.secrets/
.env
*.env

# Per-machine Claude Code state. settings.json IS generated per instance and
# tracked; settings.local.json is the local permission cache and is personal to
# whoever cloned this — it must never travel with the template.
.claude/settings.local.json

# Dependencies / caches
node_modules/
ms-playwright/

# OS / editor cruft
Thumbs.db
Desktop.ini
.DS_Store

# The build record of this OS — kept on disk, never published. The user-facing
# guide lives in docs/; everything here is about *building* the OS, not using it.
system-design/
checkpoint.md

# One-off field-research fetchers used while building this OS. They carry hardcoded
# source URLs from that research and do nothing for an instance, so they stay on disk
# and out of the published template.
scripts/research-fetch.js
scripts/research-fetch-memory.js
